{
  "name": "nuxt-box-sdk",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.9.0",
  "description": "Box TypeScript Generated SDK Nuxt module",
  "license": "MIT",
  "repository": "who-jonson/nuxt-box-sdk",
 "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "play": "pnpm dev",
    "docs:dev": "pnpm run --filter nuxt-box-sdk-docs dev",
    "release": "pnpm lint && pnpm run test && pnpm run prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@whoj/utils-core": "catalog:peer",
    "httpxy": "catalog:peer"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "box-node-sdk": "catalog:"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "catalog:lint",
    "@nuxt/module-builder": "catalog:dev",
    "@nuxt/schema": "catalog:dev",
    "@nuxt/test-utils": "catalog:test",
    "@types/node": "catalog:dev",
    "@whoj/eslint-config": "catalog:lint",
    "@whoj/utils-core": "catalog:dev",
    "changelogen": "catalog:dev",
    "eslint": "catalog:lint",
    "httpxy": "catalog:dev",
    "nuxt": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:test",
    "vue-tsc": "catalog:dev"
  },
  "peerDependenciesMeta": {
    "httpxy": {
      "optional": false
    },
    "@whoj/utils-core": {
      "optional": false
    }
  }
}
